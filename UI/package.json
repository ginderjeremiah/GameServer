{
	"name": "svelte-game",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit:ci && npm run test:e2e",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && npm run check",
		"format": "prettier --write .",
		"test:e2e": "svelte-kit sync && playwright test",
		"test:unit": "vitest",
		"test:unit:ci": "vitest --run --reporter=minimal --reporter=json --outputFile.json=./unit-test-results.json --coverage",
		"test:unit:coverage": "vitest --run --coverage"
	},
	"devDependencies": {
		"@emnapi/core": "^1.10.0",
		"@emnapi/runtime": "^1.10.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.11.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.0.1",
		"sass": "^1.105.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.7"
	},
	"type": "module"
}
